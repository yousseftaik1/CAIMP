# =============================================================================
# CAIMP v2 — Environment Variables
# Copy this file to .env and fill in all values before running `make up`.
# NEVER commit .env to version control.
# =============================================================================

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=caimp
POSTGRES_USER=caimp
POSTGRES_PASSWORD=change_me_postgres

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis

# --- NATS ---
NATS_URL=nats://nats:4222
NATS_USER=caimp
NATS_PASSWORD=change_me_nats

# --- Ollama ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- JWT ---
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_jwt_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# --- CA / PKI ---
# Passphrase for the CA private key stored encrypted in Postgres
CA_KEY_PASSPHRASE=change_me_ca_passphrase

# --- Seed (first-run demo data) ---
SEED_ADMIN_EMAIL=admin@caimp.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ORG_NAME=Demo Org

# --- OpenTelemetry Collector ---
OTELCOL_GRPC_PORT=4317
OTELCOL_HTTP_PORT=4318
OTELCOL_REQUIRE_ORG_ID=true

# --- Telemetry Writer ---
TW_BATCH_SIZE=2000
TW_BATCH_FLUSH_SECONDS=5
TW_CPU_THRESHOLD_PCT=90
TW_RAM_THRESHOLD_PCT=90
TW_DISK_THRESHOLD_PCT=85
TW_RATE_CHANGE_PCT=20
TW_ZSCORE_THRESHOLD=3.0

# --- AI Worker ---
AI_WORKER_CONCURRENCY=2

# --- Alert Engine ---
ALERT_RULES_CACHE_TTL=60

# --- Admin API ---
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# --- Application ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Grafana ---
# Admin credentials for the Grafana UI (accessible at /grafana or port 3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# --- WebSocket Gateway ---
# Port exposed by the ws-gateway service (internal :8080)
WS_GATEWAY_PORT=8080

# --- Frontend ---
# Port where the React SPA (nginx) is accessible directly (bypasses the main nginx reverse proxy)
FRONTEND_PORT=3000

# --- Nginx ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
