      "title": "Explanations Generated / sec (cache hit vs miss)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(caimp_explanations_total{cache=\"hit\"}[1m])",
          "legendFormat": "cache hit",
          "datasource": "Prometheus"
