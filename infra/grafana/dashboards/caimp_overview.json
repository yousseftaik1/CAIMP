      "title": "Query API — Request Rate by Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by(status) (rate(http_requests_total{job=\"query-api\"}[1m]))",
          "legendFormat": "{{status}}",
          "datasource": "Prometheus"
