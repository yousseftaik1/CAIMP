      "title": "LLM Explanation Latency (p50 / p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(caimp_llm_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.95, rate(caimp_llm_duration_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "datasource": "Prometheus"
        }
      ]
    },

